# Template for production env vars — copy to `.env.production.local` and fill in.
# These public-by-design values can also be set via Vercel's dashboard.

# ── Supabase (NEXT_PUBLIC_* are exposed to the browser; that is intentional) ─
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<your-publishable-key>

# ── Backend API (point at wherever you deploy FastAPI) ───────────────────
BACKEND_URL=
NEXT_PUBLIC_API_URL=

# ── NextAuth (server-side; never exposed to the browser) ─────────────────
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://your-vercel-url.vercel.app

# ── Optional: Okta SSO (only if you prefer Okta over Supabase Auth) ──────
OKTA_ISSUER=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=

# ── Optional: Sentry — leave blank to disable (SDK becomes a no-op) ──────
# Public DSN: safe to expose to the browser.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# Same DSN reused server-side for route handlers / server components.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
# Source-map upload (optional but highly recommended in prod). Get an
# auth token from Sentry → Settings → Auth Tokens (project:releases scope).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
