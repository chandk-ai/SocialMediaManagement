# ─── App ─────────────────────────────────────────────
ENV=dev

# ─── Security ────────────────────────────────────────
# Replace with a 32+ byte high-entropy value in production
SEC_TOKEN_VAULT_MASTER_KEY=replace-me-32bytes-or-longer-please!
SEC_RATE_LIMIT_PER_MINUTE=120

# ─── Okta / OIDC ─────────────────────────────────────
OKTA_ISSUER=https://your-tenant.okta.com/oauth2/default
OKTA_AUDIENCE=api://smms
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=

# ─── NextAuth (frontend) ─────────────────────────────
NEXTAUTH_SECRET=use-a-long-random-string
NEXTAUTH_URL=http://localhost:3000
# Backend URL the frontend's proxy route uses (server-to-server)
BACKEND_URL=http://localhost:8000

# Convenience: use a dev token instead of OAuth in local dev
DEV_BEARER_TOKEN=dev.admin.dev@example.com.00000000-0000-0000-0000-000000000001

# ─── LLM ─────────────────────────────────────────────
LLM_DEFAULT_PROVIDER=mock        # anthropic | openai | azure_openai | mock
LLM_ANTHROPIC_API_KEY=
LLM_OPENAI_API_KEY=

# ─── Persistence backend ─────────────────────────────
# auto = supabase if SUPABASE_URL is set, else memory
PERSISTENCE_BACKEND=auto         # auto | memory | supabase
AUTH_BACKEND=auto                # auto | okta | supabase | dev

# ─── Supabase ────────────────────────────────────────
# Find these in Supabase: Project Settings → API + Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-side ONLY — bypasses RLS
SUPABASE_JWT_SECRET=              # under Settings → API → JWT settings
SUPABASE_STORAGE_BUCKET=smms-media
SUPABASE_REALTIME_CHANNEL=smms
# Pooled connection string (Settings → Database → Connection pooling)
# Convert from `postgres://` to `postgresql+asyncpg://`
SUPABASE_POSTGRES_CONNECTION_STRING=postgresql+asyncpg://postgres:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ─── Self-hosted Postgres (only if PERSISTENCE_BACKEND=memory or you skip Supabase) ──
DB_URL=postgresql+asyncpg://smms:smms@localhost:5432/smms

# ─── Cache & queue ───────────────────────────────────
REDIS_URL=redis://localhost:6379/0
QUEUE_BROKER_URL=amqp://guest:guest@localhost:5672//
QUEUE_RESULT_BACKEND=redis://localhost:6379/1

# ─── Observability ───────────────────────────────────
OBS_LOG_LEVEL=INFO
OBS_LOG_JSON=true
# OBS_OTLP_ENDPOINT=http://otel-collector:4317
